# OpenExec Environment Variables
# Copy this file to .env and configure as needed

# Note: AI configuration is now in settings.json
# See settings.json for base_url, model, and other AI settings

# Agent settings (override config/openexec.yaml)
AGENT_ANALYSIS_DEPTH=medium
AGENTS_ENABLED=ceo,cfo,cto,cmo

# Simulation settings
SIMULATION_MAX_INTERACTIONS=10
CONFIDENCE_THRESHOLD=0.6

# Output settings
OUTPUT_FORMAT=markdown


# =============================================================================
# Docker Compose deployment
# =============================================================================
# Read by docker-compose.yml. Every value below has a working default there --
# this section documents what is tunable, not what is required.

# --- AWS ---
# Region for DynamoDB. Credentials are deliberately NOT set here: on EC2 they
# come from the instance role, and docker-compose.local.yml supplies dummy ones
# for dynamodb-local. An AWS_ACCESS_KEY_ID in the environment -- even an empty
# one -- shadows the instance role.
AWS_REGION=us-east-1

OPENEXEC_DECISIONS_TABLE=openexec-decisions
OPENEXEC_EVENTS_TABLE=openexec-events

# --- LLM configuration ---
# Host path to the settings.json holding base_url / model / api_key. Mounted
# read-only into the API container at /etc/openexec/settings.json.
#
# It is gitignored and must never be committed or baked into an image. On the
# server, keep it at 0600 and owned by root.
#
# For local development against the repo copy:
#   OPENEXEC_SETTINGS_FILE=./settings.json
OPENEXEC_SETTINGS_FILE=/etc/openexec/settings.json

# --- Web ---
# Baked into the SPA bundle at build time. Relative by design: nginx serves the
# app and proxies /api to the API container, so everything is one origin.
# Leaving this empty makes the build FAIL rather than silently ship the
# in-memory mock layer (see frontend/Dockerfile).
VITE_API_BASE_URL=/api

# Host port nginx binds. 80 for a real deployment; change it if something else
# already owns the port locally.
WEB_PORT=80
