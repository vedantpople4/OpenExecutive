# Point the frontend at a real backend instead of the built-in in-memory mocks.
# Copy to .env.local (gitignored via *.local) and uncomment to use.
# The test suite forces mocks regardless of this file (see src/api/client.ts).
# VITE_API_BASE_URL=http://localhost:8000

# Supabase project config, sign-in only -- the anon key is meant to be public in a client
# bundle. Find both in the project dashboard under Project Settings -> API.
# VITE_SUPABASE_URL=https://kmnjzxbkvfcyycwcqwhz.supabase.co
# VITE_SUPABASE_ANON_KEY=
